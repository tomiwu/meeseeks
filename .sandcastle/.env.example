# Claude subscription token: run `claude setup-token` on the host and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=
# Fine-grained PAT for tomiwu/meeseeks only.
# Permissions (read and write): Contents, Issues, Pull requests, Workflows. Metadata: read.
GH_TOKEN=

# Monitor settings
# Maximum number of issues to process in one loop run (default: 25).
SANDCASTLE_MAX_ISSUES=25
# Set to 1 to print the next issue and exit without running any agent.
SANDCASTLE_DRY_RUN=
