# Meeseeks server environment.
# Copy this file to .env and fill in the values.
# Never commit .env. The .env file is gitignored.

# --- Telegram channel ---
# Numeric Telegram user ID of the owner (Tomasz).
MEESEEKS_OWNER_ID=
# Telegram bot token from @BotFather.
MEESEEKS_TELEGRAM_BOT_TOKEN=
# Numeric Telegram chat ID for result messages (usually the same as MEESEEKS_OWNER_ID).
MEESEEKS_TELEGRAM_CHAT_ID=

# --- Journal (H2 file DB) ---
# Path to the H2 journal directory. The directory is gitignored.
MEESEEKS_JOURNAL_PATH=./data/journal

# --- Server identity ---
# Unique string stamped on every journal event. Change per instance.
MEESEEKS_WRITER_ID=prod-1

# --- Brain backend ---
# One of: fake | subscription | apikey | local
# Use fake for smoke tests. Use subscription for production.
MEESEEKS_BRAIN=fake

# Subscription backend: Podman image that contains the AI client.
MEESEEKS_SANDBOX_IMAGE=meeseeks/brain:latest
# Credential injected as ANTHROPIC_API_KEY inside the container (optional).
MEESEEKS_BRAIN_SUBSCRIPTION_CREDENTIAL=

# API key backend: direct Anthropic Messages API.
MEESEEKS_BRAIN_API_KEY=
MEESEEKS_BRAIN_API_MODEL=

# Local model backend: OpenAI-compatible endpoint (e.g. Ollama).
MEESEEKS_LOCAL_MODEL_HOST=
MEESEEKS_LOCAL_MODEL_NAME=

# --- Jev oracle (optional, off by default) ---
# Set a key to enable the Jev first-pass oracle.
MEESEEKS_JEV_API_KEY=
